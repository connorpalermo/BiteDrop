{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": false,
    "paths": {
      "@bitedrop/core": ["packages/core/src/index.ts"],
      "@bitedrop/core/mock": ["packages/core/src/mock/index.ts"],
      "@bitedrop/db": ["packages/db/src/index.ts"],
      "@bitedrop/db/seed": ["packages/db/src/seed/index.ts"],
      "@bitedrop/sources": ["packages/sources/src/index.ts"],
      "@bitedrop/llm": ["packages/llm/src/index.ts"],
      "@/*": ["apps/web/*"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/db/test/**/*.ts",
    "packages/sources/src/**/*.ts",
    "packages/sources/test/**/*.ts",
    "packages/llm/src/**/*.ts",
    "packages/llm/test/**/*.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/ingest/src/**/*.ts",
    "apps/ingest/test/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist"]
}
